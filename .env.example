PORT=5000

# MongoDB connection string — set this in production to your MongoDB Atlas or MongoDB Serverless
# WARNING: NEVER commit the real value. The server refuses to start with a placeholder value here.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/focus-room?retryWrites=true&w=majority

# JWT signing secret — long high-entropy string e.g. openssl rand -hex 32
# The server refuses to boot if this is a placeholder or empty.
JWT_SECRET=replace_with_a_long_random_secret_string_here

# Origin of the deployed frontend such as https://focus-room.vercel.app or http://localhost:5173
# In production NODE_ENV=production this MUST not point to localhost or server refuses to start.
CLIENT_URL=http://localhost:5173

# Set to production in deployments (enables strict CSP/HSTS, disables CORS for localhost, enables production env validation.
NODE_ENV=development

# Number of trusted reverse-proxy hops before the Node process.
# Deployed behind Render/Cloudflare/nginx: set to 1 (or the number of proxies).
# Defaults to 1 in production if not specified, 0 in development.
TRUST_PROXY_HOPS=
